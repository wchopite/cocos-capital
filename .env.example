NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Pretty-print JSON logs in the terminal (default: only in development).
# LOG_PRETTY=true

# Redis (quote cache; default localhost:6379).
# REDIS_URL=redis://localhost:6379

# PostgreSQL (default — run `docker compose up -d` first)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=cocos_capital
DB_SSL=false

# Schema is managed by migrations (npm run db:setup / migration:run).
# Set to true only for quick prototyping (TypeORM may drop data on changes).
DB_SYNCHRONIZE=false

# ── Neon (the provided cloud database) ─────────────────────────────
# To point the app at Neon instead of local Docker, comment out the DB_* values
# above and set these (credentials from the challenge email / shown in DBeaver).
# Then run `npm run db:recreate` once to rebuild the schema with the migrations
# + seed, and `npm run start:dev`.
# DB_HOST=ep-xxxxxxxx.<region>.aws.neon.tech
# DB_PORT=5432
# DB_USERNAME=neondb_owner
# DB_PASSWORD=<password>
# DB_DATABASE=neondb
# DB_SSL=true

# Docker Compose ports on the host
DB_PORT_HOST=5432
ADMINER_PORT=8080
